+
+    # Static bindings keep their PySide-only support libraries as separate archives.
+    for module, library in [
+        ("QtRemoteObjects", "libpyside6remoteobjects.a"),
+        ("QtUiTools", "libuiplugin.a"),
+    ]:
+        if module in qt_deps.frameworks:
+            archive = cfg.pyside6_dir / library
+            if not archive.is_file():
+                raise RuntimeError(f"{module} requires the static support archive {archive}. "
+                                   "Use a wheel that includes this archive.")
